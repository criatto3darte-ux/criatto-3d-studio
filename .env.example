# ==========================================================
# Criatto 3D — variáveis de ambiente (públicas, frontend only)
#
# Copie para .env.local (NÃO commitar) e preencha:
#   cp .env.example .env.local
#
# Estes valores são públicos (VITE_* é embutido no bundle do navegador).
# NUNCA adicione a SUPABASE_SERVICE_ROLE_KEY aqui.
# ==========================================================

# URL do projeto Supabase (ex.: https://xxxxxxxxxxxxxxxx.supabase.co)
VITE_SUPABASE_URL=https://ugwuxczcqlrdjkpjsdqb.supabase.co

# Chave anon/publishable (não a secret/service_role)
VITE_SUPABASE_ANON_KEY=

# URL pública desta aplicação (mesmo Origin que você cadastrar em
# Authentication → URL Configuration → Redirect URLs).
# Deve começar com http:// ou https:// e terminar sem barra.
# Ex.: https://admin-homolog.criatto3d.com
VITE_APP_URL=http://localhost:3000
