# ==========================================================
# Criatto 3D — variáveis de ambiente (públicas, frontend only)
#
# Copie para .env.local (NÃO commitar) e preencha:
#   cp .env.example .env.local
#
# Estes valores são públicos (VITE_* é embutido no bundle do navegador).
# NUNCA adicione a SUPABASE_SERVICE_ROLE_KEY aqui.
# NUNCA adicione senhas, tokens privados, webhook secrets aqui.
#
# O site publicado em https://criatto3d.art.br roda SEM estas variáveis
# configuradas (loja 100% estática). As rotas /admin e /auth/* só são
# ativadas quando VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY estão definidas.
# ==========================================================

# URL do projeto Supabase.
# Homologação: https://ugwuxczcqlrdjkpjsdqb.supabase.co
VITE_SUPABASE_URL=

# Chave **anon/publishable** do projeto (NÃO é service_role).
# Obter em: Supabase Dashboard → Project Settings → API → anon public key.
VITE_SUPABASE_ANON_KEY=

# URL pública desta aplicação (mesmo Origin cadastrado em
# Authentication → URL Configuration → Redirect URLs).
# Deve começar com http:// ou https:// e terminar sem barra.
# Desenvolvimento local: http://localhost:5173
VITE_APP_URL=http://localhost:5173
