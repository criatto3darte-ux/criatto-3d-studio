# Ambiente de produção (CR-010A) — MODELO.
# Copie para .env.local (NÃO commitar) para usar localmente:
#   cp .env.production.example .env.local
#
# O site publicado em https://criatto3d.art.br usa estas variáveis:
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY, VITE_APP_URL
#
# Estes valores são públicos (VITE_* é embutido no bundle do navegador).
# NUNCA adicione a SUPABASE_SERVICE_ROLE_KEY aqui.
# NUNCA adicione senhas, tokens privados, webhook secrets aqui.
#
# Os valores abaixo correspondem ao projeto Supabase de PRODUÇÃO
# tdawygjcqmclwlrermpl (criatto3d-producao), separado da homologação
# (ugwuxczcqlrdjkpjsdqb). A chave é a publishable key pública do projeto:
#   Supabase → Project Settings → API Keys → Publishable key.
#
# IMPORTANTE: VITE_APP_URL deve ser https://criatto3d.art.br para produção.
# Não use http://localhost ou URLs de túnel nesta variável.

# URL do projeto Supabase de produção.
VITE_SUPABASE_URL=https://tdawygjcqmclwlrermpl.supabase.co

# Chave anon/publishable do projeto (NÃO é service_role).
# Obter em: Supabase Dashboard → Project Settings → API → anon public key.
VITE_SUPABASE_ANON_KEY=

# URL pública da loja oficial.
VITE_APP_URL=https://criatto3d.art.br

# Checkout real: registra o pedido no Supabase (Edge Function checkout-order)
# antes de abrir o WhatsApp. Sem "true", o carrinho mostra "Checkout em preparação".
VITE_ENABLE_LIVE_CHECKOUT=true
