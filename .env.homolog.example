# Ambiente de homologação (CR-009I) — MODELO.
# Copie para .env.local (NÃO commitar) para usar:
#   cp .env.homolog.example .env.local
#
# Em DEV LOCAL (sem túnel), deixe VITE_APP_URL=http://localhost:5173.
#
# No dia do teste com túnel HTTPS (cloudflared):
#   1. bash scripts/tunnel-homolog.sh cloudflared   # em outro terminal
#   2. copie a URL https://XXXX.trycloudflare.com
#   3. ajuste VITE_APP_URL abaixo para essa URL
#   4. adicione <URL>/auth/callback ao allow-list do Supabase
#   5. inicie o Vite com: bun run dev:tunnel
#
# NÃO preencha a ANON_KEY aqui em código. Use o valor obtido no painel:
#   Supabase → Project Settings → API → anon public key.
VITE_SUPABASE_URL=https://ugwuxczcqlrdjkpjsdqb.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_APP_URL=http://localhost:5173
